{
  "name": "job-application-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "vite --config frontend/vite.config.ts --host 127.0.0.1 --port 1420 --strictPort",
    "check": "tsc --project frontend/tsconfig.json --noEmit && npm run check:config",
    "check:config": "node scripts/check-tauri-config.mjs",
    "build": "npm run check && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts --host 127.0.0.1 --port 1420 --strictPort",
    "test": "playwright test --config frontend/playwright.config.ts",
    "test:edge": "playwright test --config frontend/playwright.edge.config.ts",
    "tauri": "cd backend && tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "2.12.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
